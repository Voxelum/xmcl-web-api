# Local development secrets for `wrangler dev`.
# Copy to `apps/.dev.vars` and fill in real values. Root npm dev commands pass
# this shared local-only file explicitly to the selected Worker.
# In production set these with `wrangler secret put <NAME>`.

GITHUB_PAT=""

# MongoDB connection string (mongodb+srv://...). The mongodb driver runs on
# workerd via the nodejs_compat flag.
MONGO_CONNECION_STRING=""

RTC_SECRET=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_APP_ID=""
CURSEFORGE_KEY=""
AGNES_API_KEYS="[]"
# Full Azure Table URL including its SAS query.
AZURE_TRANSLATION_TABLE_URL=""
TRANSLATION_SCHEDULED_BATCH_LIMIT="10"
TRANSLATION_I18N_BASE="https://raw.githubusercontent.com/Voxelum/xmcl-community-content-i18n-extra/main"
XMCL_MODRINTH_CLIENT_ID=""
XMCL_MODRINTH_CLIENT_SECRET=""
