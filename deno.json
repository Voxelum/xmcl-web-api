{
  "imports": {
    "@azure/functions": "npm:@azure/functions@^4.0.0",
    "geoip-country": "npm:geoip-country@4.2.262",
    "semver": "npm:semver@^7.0.0",
    "hono": "npm:hono@4.12.27",
    "hono/": "npm:/hono@4.12.27/",
    "mongodb": "npm:mongodb@6.15.0",
    "xxhash-wasm": "npm:xxhash-wasm@^1.1.0",
    "node-html-parser": "npm:node-html-parser@^6.1.13"
  },
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --allow-sys --env apps/local/server.ts",
    "local-demo": "deno run --allow-net --allow-env apps/local/demo.ts",
    "local-demo:smoke": "deno run --allow-net --allow-env scripts/local_demo_smoke.ts",
    "check:local-demo": "deno check apps/local/demo.ts scripts/local_demo_smoke.ts"
  }
}
