# Local development secrets for `wrangler dev`.
# Copy to `.dev.vars` and fill in real values.
# In production set these with `wrangler secret put <NAME>`.

GITHUB_PAT=""

# MongoDB connection string (mongodb+srv://...). The mongodb driver runs on
# workerd via the nodejs_compat flag.
MONGO_CONNECION_STRING=""

RTC_SECRET=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_APP_ID=""
CURSEFORGE_KEY=""
XMCL_MODRINTH_CLIENT_ID=""
XMCL_MODRINTH_CLIENT_SECRET=""

# Staging-only PayPal Sandbox webhook proxy. Keep all three as Worker secrets
# in deployed environments; the URL must be the fixed Azure /api webhook path.
PAYPAL_WEBHOOK_PROXY_URL=""
XMCL_PAYPAL_WEBHOOK_PROXY_KEY_ID=""
XMCL_PAYPAL_WEBHOOK_PROXY_SECRET=""
