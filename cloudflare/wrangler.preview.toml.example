name = "xmcl-web-api-mot-preview"
main = "api.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

# This config is intentionally separate from the production configs. Replace
# values with preview-only resources and keep secrets in `wrangler secret put`.
[vars]
MONGODB_NAME = "xmcl-api-preview-mot"
TURNS = ""

[triggers]
crons = ["0 0 * * *"]
