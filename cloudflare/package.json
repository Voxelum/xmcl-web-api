{
  "name": "xmcl-web-api-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers deployment of the shared Hono XMCL Web API",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.api.toml",
    "dev:api": "wrangler dev --config wrangler.api.toml",
    "dev:ai": "wrangler dev --config wrangler.ai.toml",
    "dev:signaling": "wrangler dev --config wrangler.signaling.toml",
    "deploy": "npm run deploy:api && npm run deploy:ai && npm run deploy:signaling",
    "deploy:api": "wrangler deploy --config wrangler.api.toml",
    "deploy:ai": "wrangler deploy --config wrangler.ai.toml",
    "deploy:signaling": "wrangler deploy --config wrangler.signaling.toml",
    "typecheck": "tsc --noEmit && npm run check:bundles",
    "check:bundles": "npm run check:api && npm run check:ai && npm run check:signaling",
    "check:api": "wrangler deploy --dry-run --config wrangler.api.toml",
    "check:ai": "wrangler deploy --dry-run --config wrangler.ai.toml",
    "check:signaling": "wrangler deploy --dry-run --config wrangler.signaling.toml"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.115.0"
  }
}
